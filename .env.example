# ============================================================
# MindRush — Environment Configuration Template
# ============================================================
# Copy this file to .env and configure with your real Atlas credentials.
# NEVER commit your actual .env file or production secrets to Git.

# Server Port
PORT=3000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster-address>/MindRush?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/MindRush?retryWrites=true&w=majority

# Session Cookie Secret Key (Use a strong, 64-char random string in production)
SESSION_SECRET=<generate_a_secure_random_64_character_hex_secret>
