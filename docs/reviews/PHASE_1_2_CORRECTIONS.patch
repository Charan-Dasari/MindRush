   console.log('--------------------------------------------------------');
   console.log(` Tests Completed: ${passedTests}/${totalTests} Passed.`);
   console.log('========================================================');
diff --git a/tests/test_admin_provisioning.mjs b/tests/test_admin_provisioning.mjs
