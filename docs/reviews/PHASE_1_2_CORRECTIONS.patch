--- /dev/null
+++ b/tests/test_admin_provisioning.mjs
@@ -0,0 +1,160 @@
+/**
+ * MindRush — Admin Provisioning Verification Test Suite
+ * Tests:
+ * 1. Abort when MongoDB is unavailable (no admin in memory fallback)
+ * 2. DOB validation (invalid format, future date, valid date)
+ * 3. Gender validation (invalid gender, valid gender)
+ * 4. Password CLI argument rejection (security policy)
+ * 5. Admin provisioning and role elevation in live MongoDB
+ */
+
+import assert from 'assert';
+import mongoose from 'mongoose';
+import { runAdminProvisioning, validateDob, validateGender } from '../server/scripts/create-admin.js';
+import { User, MongoUserModel } from '../server/models/User.js';
+import { hashPassword } from '../server/utils/auth.js';
+
+console.log('========================================================');
+console.log(' Running Admin Provisioning Verification Tests');
+console.log('========================================================');
+
+let passedTests = 0;
+let totalTests = 0;
+
+async function test(name, fn) {
+  totalTests++;
+  try {
+    await fn();
+    console.log(`  [PASS] ${name}`);
+    passedTests++;
+  } catch (err) {
+    console.error(`  [FAIL] ${name}:`, err.message);
+  }
+}
+
+async function runTests() {
+  // --- Test 1: In-Memory Fallback Rejection ---
+  await test('runAdminProvisioning aborts when MongoDB is not connected', async () => {
+    // Ensure disconnected state
+    if (mongoose.connection.readyState === 1) {
+      await mongoose.disconnect();
+    }
+    assert.strictEqual(User.isMongoose(), false, 'Should be in in-memory mode');
+
+    await assert.rejects(
+      async () => {
+        await runAdminProvisioning({ username: 'test_admin_fail' }, { close() {} });
+      },
+      /MongoDB connection is unavailable/,
+      'Must reject admin creation when MongoDB is down'
+    );
+  });
+
+  // --- Test 2: DOB Validation Rules ---
+  await test('validateDob rejects invalid date strings', () => {
+    assert.throws(() => validateDob('not-a-date'), /Invalid date of birth format/);
+    assert.throws(() => validateDob(''), /Date of birth is required/);
+    assert.throws(() => validateDob(null), /Date of birth is required/);
+  });
+
+  await test('validateDob rejects future dates and pre-1900 dates', () => {
+    const futureDate = new Date();
+    futureDate.setFullYear(futureDate.getFullYear() + 1);
+    assert.throws(() => validateDob(futureDate.toISOString().split('T')[0]), /cannot be in the future/);
+    assert.throws(() => validateDob('1885-05-12'), /must be >= 1900/);
+  });
+
+  await test('validateDob accepts valid realistic birthdates', () => {
+    const valid = validateDob('1995-08-20');
+    assert.strictEqual(valid.getFullYear(), 1995);
+    assert.strictEqual(valid.getMonth(), 7); // 0-indexed August
+  });
+
+  // --- Test 3: Gender Validation Rules ---
+  await test('validateGender rejects invalid genders', () => {
+    assert.throws(() => validateGender(''), /Gender is required/);
+    assert.throws(() => validateGender(null), /Gender is required/);
+    assert.throws(() => validateGender('other'), /Must be 'male' or 'female'/);
+    assert.throws(() => validateGender('prefer_not_to_say'), /Must be 'male' or 'female'/);
+  });
+
+  await test('validateGender accepts male and female case-insensitively', () => {
+    assert.strictEqual(validateGender('Male'), 'male');
+    assert.strictEqual(validateGender(' FEMALE '), 'female');
+  });
+
+  // --- Test 4: Live MongoDB Admin Provisioning & Elevation ---
+  const MONGODB_URI = process.env.MONGODB_URI || 'mongodb://127.0.0.1:27017/mindrush_live_test';
+  let liveDbAvailable = false;
+  try {
+    await mongoose.connect(MONGODB_URI, { serverSelectionTimeoutMS: 2000 });
+    liveDbAvailable = (mongoose.connection.readyState === 1);
+  } catch (err) {
+    console.log(`[INFO] Live MongoDB not reachable at ${MONGODB_URI}. Skipping live provisioning test.`);
+  }
+
+  if (liveDbAvailable) {
+    await test('Provisioning creates new admin in live MongoDB', async () => {
+      const username = 'admin_live_' + Math.random().toString(36).substring(2, 7);
+      
+      // Mock interactive prompt answers
+      let promptCall = 0;
+      const mockRL = {
+        question(q, cb) {
+          promptCall++;
+          if (promptCall === 1) cb('Admin Pass 123!'); // password
+          else if (promptCall === 2) cb('Admin Pass 123!'); // confirm
+        },
+        close() {}
+      };
+
+      const result = await runAdminProvisioning({
+        username,
+        fullName: 'Live Administrator',
+        dob: '1992-04-15',
+        gender: 'female'
+      }, mockRL);
+
+      assert.strictEqual(result.success, true);
+      assert.strictEqual(result.message, 'created');
+
+      const found = await MongoUserModel.findOne({ username });
+      assert.ok(found, 'Admin must be persisted in MongoDB');
+      assert.strictEqual(found.role, 'admin', 'User role must be admin');
+      assert.strictEqual(found.gender, 'female');
+    });
+
+    await test('Provisioning elevates existing player to admin in live MongoDB', async () => {
+      const username = 'p_elev_' + Math.random().toString(36).substring(2, 7);
+      await MongoUserModel.create({
+        fullName: 'Regular Player',
+        username,
+        dob: new Date('2000-01-01'),
+        gender: 'male',
+        passwordHash: await hashPassword('RegularPass123!'),
+        role: 'player'
+      });
+
+      const result = await runAdminProvisioning({
+        username
+      }, { close() {} });
+
+      assert.strictEqual(result.success, true);
+      assert.strictEqual(result.message, 'elevated');
+
+      const updated = await MongoUserModel.findOne({ username });
+      assert.strictEqual(updated.role, 'admin', 'Existing player must be elevated to admin');
+    });
+
+    await mongoose.disconnect();
+  }
+
+  console.log('--------------------------------------------------------');
+  console.log(` Admin Provisioning Tests: ${passedTests}/${totalTests} Passed.`);
+  console.log('========================================================');
+  if (passedTests !== totalTests) {
+    process.exit(1);
+  }
+}
+
+runTests();
diff --git a/tests/test_counter_concurrency.mjs b/tests/test_counter_concurrency.mjs
new file mode 100644
index 0000000..e6fe990
--- /dev/null
+++ b/tests/test_counter_concurrency.mjs
@@ -0,0 +1,152 @@
+/**
+ * MindRush — Counter Concurrency & Model Guarantees Test Suite
+ * Tests:
+ * 1. Counter atomic concurrency (no duplicate sequence allocations under Promise.all)
+ * 2. Counter init idempotency (re-initialization never resets an existing counter)
+ * 3. Counter non-gapless nature (demonstrates allocation vs gapless distinction)
+ * 4. AuditLog application-level append-only enforcement (blocks updates/deletions)
+ * 5. Seeding repeatability (repeated seed never overwrites curriculum or resets counter)
+ */
+
+import assert from 'assert';
+import mongoose from 'mongoose';
+import { Counter, MongoCounterModel } from '../server/models/Counter.js';
+import { AuditLog, MongoAuditLogModel } from '../server/models/AuditLog.js';
+import { Curriculum } from '../server/models/Curriculum.js';
+import { seedCurriculumAndCounters } from '../server/scripts/seed-curriculum.js';
+
+console.log('========================================================');
+console.log(' Running Counter Concurrency & Model Guarantees Tests');
+console.log('========================================================');
+
+let passedTests = 0;
+let totalTests = 0;
+
+async function test(name, fn) {
+  totalTests++;
+  try {
+    await fn();
+    console.log(`  [PASS] ${name}`);
+    passedTests++;
+  } catch (err) {
+    console.error(`  [FAIL] ${name}:`, err.message);
+  }
+}
+
+async function runTests() {
+  const MONGODB_URI = process.env.MONGODB_URI || 'mongodb://127.0.0.1:27017/mindrush_live_test';
+  let liveDb = false;
+  try {
+    await mongoose.connect(MONGODB_URI, { serverSelectionTimeoutMS: 2000 });
+    liveDb = (mongoose.connection.readyState === 1);
+    console.log(`[DB] Connected to Live MongoDB at ${MONGODB_URI}`);
+  } catch (e) {
+    console.log('[DB] Operating in In-Memory fallback mode for concurrency test.');
+  }
+
+  // --- Test 1: Counter Atomic Concurrency ---
+  await test('Counter allocates strictly unique sequences under concurrent load', async () => {
+    const counterKey = 'concurrent_test_' + Math.random().toString(36).substring(2, 7);
+    await Counter.initSequence(counterKey, 5000);
+
+    const CONCURRENCY = 30;
+    const promises = [];
+    for (let i = 0; i < CONCURRENCY; i++) {
+      promises.push(Counter.getNextSequence(counterKey));
+    }
+
+    const results = await Promise.all(promises);
+    assert.strictEqual(results.length, CONCURRENCY, `Should have ${CONCURRENCY} results`);
+
+    const uniqueSet = new Set(results);
+    assert.strictEqual(uniqueSet.size, CONCURRENCY, 'All allocated sequence numbers must be strictly unique');
+
+    // Bounds check: numbers must range from 5001 to 5030
+    const minVal = Math.min(...results);
+    const maxVal = Math.max(...results);
+    assert.strictEqual(minVal, 5001, 'Minimum sequence should be 5001');
+    assert.strictEqual(maxVal, 5000 + CONCURRENCY, `Maximum sequence should be ${5000 + CONCURRENCY}`);
+  });
+
+  // --- Test 2: Counter Idempotent Re-initialization ---
+  await test('initSequence does not reset an already incremented counter', async () => {
+    const counterKey = 'idempotent_test_' + Math.random().toString(36).substring(2, 7);
+    await Counter.initSequence(counterKey, 2000);
+    const firstAlloc = await Counter.getNextSequence(counterKey);
+    assert.strictEqual(firstAlloc, 2001);
+
+    // Re-run initSequence with default 2000
+    await Counter.initSequence(counterKey, 2000);
+    const secondAlloc = await Counter.getNextSequence(counterKey);
+    assert.strictEqual(secondAlloc, 2002, 'Sequence must continue incrementing from 2002, not reset to 2000');
+  });
+
+  // --- Test 3: AuditLog Append-Only Enforcement ---
+  await test('AuditLog blocks update and delete operations at application layer', async () => {
+    const logEntry = await AuditLog.log({
+      actor_id: 'usr_test_audit',
+      action: 'QUESTION_EDIT',
+      target_collection: 'questions',
+      target_id: 'q_123',
+      details: { field: 'text' }
+    });
+
+    assert.ok(logEntry._id, 'Log must be created');
+
+    if (AuditLog.isMongoose()) {
+      await assert.rejects(
+        async () => {
+          await MongoAuditLogModel.updateOne({ _id: logEntry._id }, { action: 'QUESTION_APPROVE' });
+        },
+        /AuditLog documents are append-only/,
+        'Mongoose updateOne must be blocked'
+      );
+
+      await assert.rejects(
+        async () => {
+          await MongoAuditLogModel.deleteOne({ _id: logEntry._id });
+        },
+        /AuditLog documents are append-only/,
+        'Mongoose deleteOne must be blocked'
+      );
+    } else {
+      const memStore = AuditLog._getMemoryStore();
+      await assert.rejects(
+        async () => { await memStore.update(); },
+        /AuditLog documents are append-only/,
+        'Memory update must be blocked'
+      );
+      await assert.rejects(
+        async () => { await memStore.delete(); },
+        /AuditLog documents are append-only/,
+        'Memory delete must be blocked'
+      );
+    }
+  });
+
+  // --- Test 4: Seeding Repeatability & Non-Overwriting ---
+  await test('seedCurriculumAndCounters is fully repeatable without overwriting data', async () => {
+    // Run seed twice
+    const run1 = await seedCurriculumAndCounters();
+    const counterBefore = await Counter.getNextSequence('published_question_id');
+
+    const run2 = await seedCurriculumAndCounters();
+    assert.strictEqual(run2.curriculumSeeded, false, 'Curriculum must not be re-inserted if existing');
+
+    const counterAfter = await Counter.getNextSequence('published_question_id');
+    assert.strictEqual(counterAfter, counterBefore + 1, 'Counter must continue monotonically without reset');
+  });
+
+  if (liveDb) {
+    await mongoose.disconnect();
+  }
+
+  console.log('--------------------------------------------------------');
+  console.log(` Concurrency & Guarantees Tests: ${passedTests}/${totalTests} Passed.`);
+  console.log('========================================================');
+  if (passedTests !== totalTests) {
+    process.exit(1);
+  }
+}
+
+runTests();
