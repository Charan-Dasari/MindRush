+/**
+ * MindRush — Curriculum Model
+ * Physical Collection: curricula
+ * Hierarchical syllabus tree representing educational curricula, standards, subjects, and topics.
+ */
+
+import mongoose from 'mongoose';
+
+const subtopicSchema = new mongoose.Schema({
+  subtopic_id: { type: String, required: true, trim: true },
+  name: { type: String, required: true },
+  learning_outcomes: [{ type: String }],
+  allowed_concepts: [{ type: String }],
+  prerequisite_concepts: [{ type: String }]
+}, { _id: false });
+
+const topicSchema = new mongoose.Schema({
+  topic_id: { type: String, required: true, trim: true },
+  name: { type: String, required: true },
+  subtopics: [subtopicSchema],
+  difficulty_definitions: {
+    easy: { type: String, required: true },
+    medium: { type: String, required: true },
+    hard: { type: String, required: true }
+  }
+}, { _id: false });
+
+const subjectSchema = new mongoose.Schema({
+  subject_id: { type: String, required: true, trim: true },
+  name: { type: String, required: true },
+  topics: [topicSchema]
+}, { _id: false });
+
+const standardSchema = new mongoose.Schema({
+  standard: { type: Number, required: true, enum: [1, 2, 3] },
+  subjects: [subjectSchema]
+}, { _id: false });
+
+const curriculumSchema = new mongoose.Schema({
+  curriculum_id: { type: String, required: true, unique: true, trim: true },
+  name: { type: String, required: true, trim: true },
+  board: { type: String, required: true, trim: true },
+  country: { type: String, required: true, trim: true },
+  academic_year: { type: String, default: null },
+  syllabus_version: { type: String, default: null },
+  standards: [standardSchema]
+}, {
+  timestamps: true,
+  collection: 'curricula'
+});
+
+export const MongoCurriculumModel = mongoose.models.Curriculum || mongoose.model('Curriculum', curriculumSchema);
+
+class MemoryCurriculumStore {
+  constructor() {
+    this.curricula = new Map();
+  }
+
+  clear() {
+    this.curricula.clear();
+  }
+
+  async findOne(query) {
+    if (query.curriculum_id) {
+      return this.curricula.get(query.curriculum_id) || null;
+    }
+    for (const c of this.curricula.values()) {
+      return c;
+    }
+    return null;
+  }
+
+  async create(data) {
+    if (this.curricula.has(data.curriculum_id)) {
+      const err = new Error(`E11000 duplicate key error: curriculum_id ${data.curriculum_id} already exists`);
+      err.code = 11000;
+      throw err;
+    }
+    const doc = {
+      _id: 'curr_' + Math.random().toString(36).substring(2, 11),
+      ...data,
+      createdAt: new Date(),
+      updatedAt: new Date()
+    };
+    this.curricula.set(data.curriculum_id, doc);
+    return doc;
+  }
+
+  async find() {
+    return Array.from(this.curricula.values());
+  }
+}
+
+const memoryStore = new MemoryCurriculumStore();
+
+export const Curriculum = {
+  isMongoose() {
+    return mongoose.connection.readyState === 1;
+  },
+
+  async findOne(query) {
+    if (this.isMongoose()) {
+      return MongoCurriculumModel.findOne(query);
+    }
+    return memoryStore.findOne(query);
+  },
+
+  async create(data) {
+    if (this.isMongoose()) {
+      return MongoCurriculumModel.create(data);
+    }
+    return memoryStore.create(data);
+  },
+
+  async find(query = {}) {
+    if (this.isMongoose()) {
+      return MongoCurriculumModel.find(query);
+    }
+    return memoryStore.find();
+  },
+
+  _getMemoryStore() {
+    return memoryStore;
+  }
+};
