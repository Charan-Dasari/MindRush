+/**
+ * MindRush — AuditLog Model
+ * Physical Collection: audit_logs
+ * Immutable audit register recording administrative actions.
+ */
+
+import mongoose from 'mongoose';
+
+const auditLogSchema = new mongoose.Schema({
+  actor_id: {
+    type: mongoose.Schema.Types.Mixed, // ObjectId in Mongo, String in memory
+    ref: 'User',
+    required: true
+  },
+  action: {
+    type: String,
+    required: true,
+    enum: [
+      'DOCUMENT_UPLOAD',
+      'BATCH_GENERATE',
+      'QUESTION_EDIT',
+      'QUESTION_APPROVE',
+      'QUESTION_REJECT',
+      'QUESTION_PUBLISH',
+      'QUESTION_DISABLE'
+    ]
+  },
+  target_collection: {
+    type: String,
+    required: true
+  },
+  target_id: {
+    type: String,
+    required: true
+  },
+  details: {
+    type: mongoose.Schema.Types.Mixed,
+    default: {}
+  },
+  ip_address: {
+    type: String,
+    default: null
+  }
+}, {
+  timestamps: true,
+  collection: 'audit_logs'
+});
+
+auditLogSchema.index({ action: 1, createdAt: -1 });
+auditLogSchema.index({ actor_id: 1, createdAt: -1 });
+auditLogSchema.index({ target_id: 1 });
+
+export const MongoAuditLogModel = mongoose.models.AuditLog || mongoose.model('AuditLog', auditLogSchema);
+
+class MemoryAuditLogStore {
+  constructor() {
+    this.logs = [];
+  }
+
+  clear() {
+    this.logs = [];
+  }
+
+  async create(data) {
+    const entry = {
+      _id: 'log_' + Math.random().toString(36).substring(2, 11),
+      ...data,
+      createdAt: new Date(),
+      updatedAt: new Date()
+    };
+    this.logs.push(entry);
+    return entry;
+  }
+
+  async find(query = {}) {
+    let result = [...this.logs];
+    if (query.action) {
+      result = result.filter(l => l.action === query.action);
+    }
+    if (query.actor_id) {
+      result = result.filter(l => String(l.actor_id) === String(query.actor_id));
+    }
+    if (query.target_id) {
+      result = result.filter(l => l.target_id === query.target_id);
+    }
+    return result.sort((a, b) => b.createdAt - a.createdAt);
+  }
+}
+
+const memoryStore = new MemoryAuditLogStore();
+
+export const AuditLog = {
+  isMongoose() {
+    return mongoose.connection.readyState === 1;
+  },
+
+  async log({ actor_id, action, target_collection, target_id, details = {}, ip_address = null }) {
+    const data = { actor_id, action, target_collection, target_id, details, ip_address };
+    if (this.isMongoose()) {
+      return MongoAuditLogModel.create(data);
+    }
+    return memoryStore.create(data);
+  },
+
+  async find(query = {}) {
+    if (this.isMongoose()) {
+      return MongoAuditLogModel.find(query).sort({ createdAt: -1 });
+    }
+    return memoryStore.find(query);
+  },
+
+  _getMemoryStore() {
+    return memoryStore;
+  }
+};
