@@ -0,0 +1,83 @@
+/**
+ * MindRush — Counter Model
+ * Physical Collection: counters
+ * Provides atomic, monotonic integer sequence allocation (using MongoDB $inc).
+ */
+
+import mongoose from 'mongoose';
+
+const counterSchema = new mongoose.Schema({
+  _id: { type: String, required: true }, // e.g. "published_question_id"
+  seq: { type: Number, default: 1000 }
+}, {
+  collection: 'counters'
+});
+
+counterSchema.statics.getNextSequence = async function(name) {
+  const counter = await this.findByIdAndUpdate(
+    name,
+    { $inc: { seq: 1 } },
+    { new: true, upsert: true }
+  );
+  return counter.seq;
+};
+
+export const MongoCounterModel = mongoose.models.Counter || mongoose.model('Counter', counterSchema);
+
+class MemoryCounterStore {
+  constructor() {
+    this.counters = new Map([
+      ['published_question_id', 1000]
+    ]);
+  }
+
+  clear() {
+    this.counters.clear();
+    this.counters.set('published_question_id', 1000);
+  }
+
+  async getNextSequence(name) {
+    const current = this.counters.get(name) || 1000;
+    const next = current + 1;
+    this.counters.set(name, next);
+    return next;
+  }
+
+  async setSequence(name, value) {
+    this.counters.set(name, value);
+    return value;
+  }
+}
+
+const memoryStore = new MemoryCounterStore();
+
+export const Counter = {
+  isMongoose() {
+    return mongoose.connection.readyState === 1;
+  },
+
+  async getNextSequence(name) {
+    if (this.isMongoose()) {
+      return MongoCounterModel.getNextSequence(name);
+    }
+    return memoryStore.getNextSequence(name);
+  },
+
+  async initSequence(name, initialValue = 1000) {
+    if (this.isMongoose()) {
+      return MongoCounterModel.findByIdAndUpdate(
+        name,
+        { $setOnInsert: { seq: initialValue } },
+        { upsert: true, new: true }
+      );
+    }
+    if (!memoryStore.counters.has(name)) {
+      memoryStore.counters.set(name, initialValue);
+    }
+    return { _id: name, seq: memoryStore.counters.get(name) };
+  },
+
+  _getMemoryStore() {
+    return memoryStore;
+  }
+};
