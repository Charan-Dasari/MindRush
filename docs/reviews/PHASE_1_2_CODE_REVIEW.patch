+#!/usr/bin/env node
+/**
+ * MindRush — Secure Administrator Provisioning Script
+ * Provisions an administrator account directly in MongoDB.
+ * 
+ * Usage:
+ *   Interactive:     node server/scripts/create-admin.js
+ *   With arguments:  node server/scripts/create-admin.js --username=sysadmin
+ *   Automated test:  node server/scripts/create-admin.js --username=sysadmin --password=Secret123! --fullName="System Admin" --dob=1990-01-01 --gender=male --non-interactive
+ */
+
+import readline from 'readline';
+import dotenv from 'dotenv';
+import path from 'path';
+import { fileURLToPath } from 'url';
+import mongoose from 'mongoose';
+import { connectDB } from '../db.js';
+import { User, MongoUserModel } from '../models/User.js';
+import { hashPassword } from '../utils/auth.js';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+dotenv.config({ path: path.resolve(__dirname, '../../.env') });
+
+function parseArgs() {
+  const args = {};
+  process.argv.slice(2).forEach(arg => {
+    if (arg.startsWith('--')) {
+      const [key, value] = arg.slice(2).split('=');
+      args[key] = value !== undefined ? value : true;
+    }
+  });
+  return args;
+}
+
+function promptQuestion(rl, query, isHidden = false) {
+  return new Promise(resolve => {
+    if (!isHidden) {
+      rl.question(query, answer => resolve(answer.trim()));
+      return;
+    }
+
+    process.stdout.write(query);
+    let input = '';
+    
+    // In raw mode, hide password keystrokes
+    const wasRaw = process.stdin.isRaw;
+    if (process.stdin.setRawMode) {
+      process.stdin.setRawMode(true);
+    }
+    process.stdin.resume();
+
+    const onData = chunk => {
+      const char = chunk.toString();
+      if (char === '\n' || char === '\r' || char === '\u0004') {
+        if (process.stdin.setRawMode) process.stdin.setRawMode(wasRaw);
+        process.stdin.removeListener('data', onData);
+        process.stdout.write('\n');
+        resolve(input.trim());
+      } else if (char === '\u0008' || char === '\u007f') { // Backspace
+        if (input.length > 0) {
+          input = input.slice(0, -1);
+          process.stdout.write('\b \b');
+        }
+      } else if (char === '\u0003') { // Ctrl+C
+        process.exit(1);
+      } else {
+        input += char;
+        process.stdout.write('*');
+      }
+    };
+
+    process.stdin.on('data', onData);
+  });
+}
+
+async function main() {
+  const args = parseArgs();
+  console.log('========================================================');
+  console.log(' MindRush — Secure Administrator Account Provisioning');
+  console.log('========================================================');
+
+  const connected = await connectDB();
+  console.log(connected ? '[DB] Connected to MongoDB.' : '[DB] Operating in local memory fallback.');
+
+  let username = args.username;
+  let fullName = args.fullName;
+  let dob = args.dob;
+  let gender = args.gender;
+  let password = args.password;
+
+  const rl = readline.createInterface({
+    input: process.stdin,
+    output: process.stdout
+  });
+
+  try {
+    if (!username) {
+      username = await promptQuestion(rl, 'Enter Admin Username (3-16 chars): ');
+    }
+    username = username.toLowerCase().trim();
+
+    if (!/^[a-zA-Z0-9_]{3,16}$/.test(username)) {
+      throw new Error('Invalid username format: 3-16 alphanumeric or underscore characters required.');
+    }
+
+    // Check if user already exists
+    const existing = await User.findByUsername(username);
+    if (existing) {
+      if (existing.role === 'admin') {
+        console.log(`[INFO] User '${username}' is already provisioned with role 'admin'.`);
+        process.exit(0);
+      }
+      console.log(`[INFO] Existing player account '${username}' found. Elevating role to 'admin'...`);
+      if (User.isMongoose()) {
+        await MongoUserModel.updateOne({ username }, { role: 'admin' });
+      } else {
+        existing.role = 'admin';
+        User._getMemoryStore().users.set(String(existing._id), existing);
+      }
+      console.log(`[SUCCESS] Account '${username}' elevated to role 'admin'.`);
+      process.exit(0);
+    }
+
+    if (!fullName) {
+      fullName = await promptQuestion(rl, 'Enter Full Name: ');
+    }
+    if (!dob) {
+      dob = await promptQuestion(rl, 'Enter Date of Birth (YYYY-MM-DD): ');
+    }
+    if (!gender) {
+      gender = await promptQuestion(rl, 'Enter Gender (male/female): ');
+    }
+
+    if (!password) {
+      password = await promptQuestion(rl, 'Enter Admin Password (min 8 chars): ', true);
+      const confirm = await promptQuestion(rl, 'Confirm Admin Password: ', true);
+      if (password !== confirm) {
+        throw new Error('Passwords do not match.');
+      }
+    }
+
+    if (!password || password.length < 8) {
+      throw new Error('Password must be at least 8 characters long.');
+    }
+
+    console.log('[SECURITY] Generating Argon2id password hash...');
+    const passwordHash = await hashPassword(password);
+
+    console.log('[PROVISIONING] Creating administrator record...');
+    const adminUser = await User.create({
+      fullName: fullName.trim(),
+      username,
+      dob: new Date(dob),
+      gender: gender.toLowerCase().trim(),
+      passwordHash,
+      role: 'admin'
+    });
+
+    console.log(`[SUCCESS] Administrator account '${adminUser.username}' created with role 'admin' (ID: ${adminUser._id || adminUser.id}).`);
+  } catch (err) {
+    console.error(`[ERROR] Provisioning failed: ${err.message}`);
+    process.exitCode = 1;
+  } finally {
+    rl.close();
+    if (mongoose.connection.readyState === 1) {
+      await mongoose.disconnect();
+    }
+  }
+}
+
+main();
