-// Application-level append-only enforcement: block update and delete queries
+// Application-level append-only enforcement:
+// Blocks all Mongoose query mutations, document mutations, and bulk write updates/deletes.
+// (Note: Direct raw MongoDB driver queries or administrative DBA access bypass Mongoose hooks,
+// so application-level append-only semantics do not claim raw database-level immutability).
 const blockMutation = function() {
   throw new Error('AuditLog documents are append-only and cannot be modified or deleted at the application layer.');
 };
 
+// Query-level mutation blocks
 auditLogSchema.pre('updateOne', blockMutation);
 auditLogSchema.pre('updateMany', blockMutation);
 auditLogSchema.pre('findOneAndUpdate', blockMutation);
+auditLogSchema.pre('replaceOne', blockMutation);
+auditLogSchema.pre('findOneAndReplace', blockMutation);
 auditLogSchema.pre('deleteOne', blockMutation);
 auditLogSchema.pre('deleteMany', blockMutation);
 auditLogSchema.pre('findOneAndDelete', blockMutation);
 
+// Document-level mutation blocks
+auditLogSchema.pre('save', function() {
+  if (!this.isNew) {
+    throw new Error('AuditLog documents are append-only and cannot be modified or deleted at the application layer.');
+  }
+});
+auditLogSchema.pre('deleteOne', { document: true, query: false }, blockMutation);
+
 export const MongoAuditLogModel = mongoose.models.AuditLog || mongoose.model('AuditLog', auditLogSchema);
+
+// Intercept bulkWrite to prevent bulk update, replace, or delete operations
+const originalBulkWrite = MongoAuditLogModel.bulkWrite.bind(MongoAuditLogModel);
+MongoAuditLogModel.bulkWrite = async function(ops, options) {
+  if (Array.isArray(ops)) {
+    for (const op of ops) {
+      if (op.updateOne || op.updateMany || op.replaceOne || op.deleteOne || op.deleteMany) {
+        throw new Error('AuditLog documents are append-only and cannot be modified or deleted via bulkWrite.');
+      }
+    }
+  }
+  return originalBulkWrite(ops, options);
+};
 
